# CargoIQ local development configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Preserve the existing prototype database unless intentionally migrating it.
DATABASE_URL=sqlite:///./kavach.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
VIDEO_MAX_SIZE_MB=500
CLIP_PRE_SECONDS=3
CLIP_POST_SECONDS=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional notification configuration; leave blank when not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SUPERVISOR_EMAIL=
